{
  "hooks": {
    "beforeShellExecution": {
      "command": "bash .harness/hooks/guard-dangerous.sh",
      "timeout": 5
    },
    "afterFileEdit": {
      "command": "bash .harness/hooks/post-write.sh",
      "timeout": 15,
      "async": true
    },
    "stop": {
      "command": "bash .harness/hooks/session-end-guard.sh",
      "timeout": 10
    }
  }
}
