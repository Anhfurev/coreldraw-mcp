# ============================================================
# LLM API Key — 三选一，填哪个就用哪个 Provider
# ============================================================

# Anthropic Claude（默认）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# DeepSeek（OpenAI 兼容）
# DEEPSEEK_API_KEY=sk-xxxxx

# 阿里云百炼 / 通义千问（OpenAI 兼容）
# DASHSCOPE_API_KEY=sk-xxxxx

# 其他 OpenAI 兼容接口
# OPENAI_API_KEY=sk-xxxxx

# ============================================================
# MCP Server 传输模式
# ============================================================

# 传输模式：stdio（供 MCP 客户端调用）或 streamable-http（本地 HTTP）
MCP_TRANSPORT=streamable-http

# HTTP 模式监听地址和端口（stdio 模式下无效）
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ============================================================
# CorelDRAW 连接（可选，有默认值）
# ============================================================

# CorelDRAW COM 应用名称，一般不需要修改
# COREL_CORELDRAW_APP_NAME=CorelDRAW.Application

# 启动时是否显示 CorelDRAW 窗口
# COREL_CORELDRAW_VISIBLE=true

# COM 连接失败最大重试次数
# COREL_MAX_RETRY_ATTEMPTS=3

# ============================================================
# 路径配置（可选，有默认值）
# ============================================================

# CDR 模板文件目录
# COREL_TEMPLATES_DIR=templates

# 导出文件输出目录
# COREL_OUTPUT_DIR=output
